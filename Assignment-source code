import tkinter as tk
from tkinter import messagebox, simpledialog


# =========================================================
# WATER RECORDS - DICTIONARY OF LISTS
# =========================================================

water = {
    "id": [],
    "zone": [],
    "supplied": [],
    "date": [],
    "consumed": []
}


# =========================================================
# CONSUMPTION CATEGORY
# =========================================================

def get_category(index):

    supplied = water["supplied"][index]
    consumed = water["consumed"][index]

    if supplied == 0:
        return "Invalid"

    percent = (consumed / supplied) * 100

    if percent < 50:
        return "Low Consumption"
    elif percent <= 80:
        return "Moderate Consumption"
    else:
        return "High Consumption"


# =========================================================
# CLEAR INPUT FIELDS
# =========================================================

def clear_fields():

    id_entry.delete(0, tk.END)
    zone_entry.delete(0, tk.END)
    supplied_entry.delete(0, tk.END)
    date_entry.delete(0, tk.END)
    consumed_entry.delete(0, tk.END)


# =========================================================
# 1. ADD WATER DISTRIBUTION RECORD
# =========================================================

def add_record():

    household_id = id_entry.get().strip()
    zone = zone_entry.get().strip()
    supplied = supplied_entry.get().strip()
    date = date_entry.get().strip()
    consumed = consumed_entry.get().strip()

    if not household_id or not zone or not supplied or not date or not consumed:
        messagebox.showwarning(
            "Missing Data",
            "Please enter all details."
        )
        return

    try:
        supplied = float(supplied)
        consumed = float(consumed)
    except ValueError:
        messagebox.showerror(
            "Invalid Data",
            "Water values must be numbers."
        )
        return

    if supplied <= 0 or consumed < 0:
        messagebox.showerror(
            "Invalid Data",
            "Enter valid water values."
        )
        return

    if consumed > supplied:
        messagebox.showwarning(
            "Warning",
            "Consumption cannot be greater than supplied water."
        )
        return

    water["id"].append(household_id)
    water["zone"].append(zone)
    water["supplied"].append(supplied)
    water["date"].append(date)
    water["consumed"].append(consumed)

    messagebox.showinfo(
        "Success",
        "Water distribution record added successfully."
    )

    clear_fields()
    update_dashboard()


# =========================================================
# 2. DISPLAY ALL RECORDS
# =========================================================

def display_records():

    output.delete("1.0", tk.END)

    if len(water["id"]) == 0:
        output.insert(tk.END, "No records available.\n")
        return

    output.insert(
        tk.END,
        "WATER DISTRIBUTION RECORDS\n"
    )
    output.insert(
        tk.END,
        "=" * 100 + "\n"
    )

    heading = (
        f"{'ID':<12}"
        f"{'ZONE':<15}"
        f"{'SUPPLIED':<15}"
        f"{'DATE':<15}"
        f"{'CONSUMED':<15}"
        f"CATEGORY\n"
    )

    output.insert(tk.END, heading)
    output.insert(tk.END, "-" * 100 + "\n")

    for i in range(len(water["id"])):

        output.insert(
            tk.END,
            f"{water['id'][i]:<12}"
            f"{water['zone'][i]:<15}"
            f"{water['supplied'][i]:<15.2f}"
            f"{water['date'][i]:<15}"
            f"{water['consumed'][i]:<15.2f}"
            f"{get_category(i)}\n"
        )


# =========================================================
# 3. SEARCH RECORDS
# =========================================================

def search_records():

    keyword = search_entry.get().strip().lower()

    output.delete("1.0", tk.END)

    if keyword == "":
        display_records()
        return

    found = False

    output.insert(
        tk.END,
        "SEARCH RESULTS\n"
    )
    output.insert(
        tk.END,
        "=" * 100 + "\n"
    )

    for i in range(len(water["id"])):

        if (
            keyword in water["id"][i].lower()
            or keyword in water["zone"][i].lower()
            or keyword in water["date"][i].lower()
        ):

            output.insert(
                tk.END,
                f"ID         : {water['id'][i]}\n"
                f"Zone       : {water['zone'][i]}\n"
                f"Supplied   : {water['supplied'][i]:.2f} L\n"
                f"Date       : {water['date'][i]}\n"
                f"Consumed   : {water['consumed'][i]:.2f} L\n"
                f"Category   : {get_category(i)}\n"
                f"{'-' * 60}\n"
            )

            found = True

    if not found:
        output.insert(
            tk.END,
            "No matching records found.\n"
        )


# =========================================================
# 4. CONSUMPTION CLASSIFICATION
# =========================================================

def show_classification():

    output.delete("1.0", tk.END)

    if len(water["id"]) == 0:
        output.insert(tk.END, "No records available.")
        return

    output.insert(
        tk.END,
        "CONSUMPTION CLASSIFICATION\n"
    )
    output.insert(
        tk.END,
        "=" * 60 + "\n\n"
    )

    for i in range(len(water["id"])):

        supplied = water["supplied"][i]
        consumed = water["consumed"][i]

        percentage = (consumed / supplied) * 100
        category = get_category(i)

        output.insert(
            tk.END,
            f"ID: {water['id'][i]}\n"
            f"Zone: {water['zone'][i]}\n"
            f"Consumption: {consumed:.2f} L\n"
            f"Usage Percentage: {percentage:.2f}%\n"
            f"Classification: {category}\n"
            f"{'-' * 60}\n"
        )


# =========================================================
# 5. WATER ANALYSIS
# =========================================================

def water_analysis():

    output.delete("1.0", tk.END)

    if len(water["id"]) == 0:
        output.insert(tk.END, "No records available.")
        return

    total_supplied = sum(water["supplied"])
    total_consumed = sum(water["consumed"])
    remaining = total_supplied - total_consumed

    average = total_consumed / len(water["consumed"])

    if total_supplied > 0:
        percentage = (total_consumed / total_supplied) * 100
    else:
        percentage = 0

    output.insert(
        tk.END,
        "WATER ANALYSIS\n"
    )

    output.insert(
        tk.END,
        "=" * 60 + "\n\n"
    )

    output.insert(
        tk.END,
        f"Total Water Supplied     : {total_supplied:.2f} L\n\n"
    )

    output.insert(
        tk.END,
        f"Total Water Consumed     : {total_consumed:.2f} L\n\n"
    )

    output.insert(
        tk.END,
        f"Remaining Water          : {remaining:.2f} L\n\n"
    )

    output.insert(
        tk.END,
        f"Average Consumption      : {average:.2f} L\n\n"
    )

    output.insert(
        tk.END,
        f"Consumption Percentage   : {percentage:.2f}%\n"
    )


# =========================================================
# 6. IDENTIFY EXCESSIVE CONSUMPTION
# =========================================================

def excessive_consumption():

    limit = simpledialog.askfloat(
        "Consumption Limit",
        "Enter maximum consumption limit in litres:"
    )

    if limit is None:
        return

    output.delete("1.0", tk.END)

    output.insert(
        tk.END,
        "EXCESSIVE WATER CONSUMPTION\n"
    )

    output.insert(
        tk.END,
        "=" * 70 + "\n\n"
    )

    found = False

    for i in range(len(water["id"])):

        if water["consumed"][i] > limit:

            output.insert(
                tk.END,
                f"ID          : {water['id'][i]}\n"
                f"Zone        : {water['zone'][i]}\n"
                f"Consumption : {water['consumed'][i]:.2f} L\n"
                f"Limit       : {limit:.2f} L\n"
                f"{'-' * 60}\n"
            )

            found = True

    if not found:

        output.insert(
            tk.END,
            "No household exceeds the specified limit."
        )


# =========================================================
# 7. ZONE-WISE ANALYSIS
# =========================================================

def zone_analysis():

    output.delete("1.0", tk.END)

    if len(water["id"]) == 0:
        output.insert(tk.END, "No records available.")
        return

    zones = set(water["zone"])

    output.insert(
        tk.END,
        "ZONE-WISE WATER CONSUMPTION\n"
    )

    output.insert(
        tk.END,
        "=" * 60 + "\n\n"
    )

    for zone in zones:

        zone_total = 0
        zone_users = 0

        for i in range(len(water["zone"])):

            if water["zone"][i] == zone:

                zone_total += water["consumed"][i]
                zone_users += 1

        output.insert(
            tk.END,
            f"Zone             : {zone}\n"
            f"Number of Users  : {zone_users}\n"
            f"Total Consumption: {zone_total:.2f} L\n"
            f"{'-' * 60}\n"
        )


# =========================================================
# 8. UNIQUE DATA ANALYSIS
# =========================================================

def unique_analysis():

    output.delete("1.0", tk.END)

    unique_users = set(water["id"])
    unique_zones = set(water["zone"])
    unique_categories = set()

    for i in range(len(water["id"])):

        unique_categories.add(
            get_category(i)
        )

    output.insert(
        tk.END,
        "UNIQUE DATA ANALYSIS\n"
    )

    output.insert(
        tk.END,
        "=" * 60 + "\n\n"
    )

    output.insert(
        tk.END,
        "Unique Household / Building IDs:\n"
    )

    output.insert(
        tk.END,
        str(unique_users) + "\n\n"
    )

    output.insert(
        tk.END,
        "Unique Zones:\n"
    )

    output.insert(
        tk.END,
        str(unique_zones) + "\n\n"
    )

    output.insert(
        tk.END,
        "Unique Consumption Categories:\n"
    )

    output.insert(
        tk.END,
        str(unique_categories) + "\n"
    )


# =========================================================
# 9. SAVE RECORDS
# =========================================================

def save_records():

    try:

        with open("water_records.txt", "w") as file:

            for i in range(len(water["id"])):

                line = (
                    water["id"][i] + "|" +
                    water["zone"][i] + "|" +
                    str(water["supplied"][i]) + "|" +
                    water["date"][i] + "|" +
                    str(water["consumed"][i]) + "\n"
                )

                file.write(line)

        messagebox.showinfo(
            "Saved",
            "Water records saved successfully."
        )

    except Exception as error:

        messagebox.showerror(
            "Error",
            str(error)
        )


# =========================================================
# 9. LOAD PREVIOUS RECORDS
# =========================================================

def load_records():

    try:

        with open("water_records.txt", "r") as file:

            for key in water:
                water[key].clear()

            for line in file:

                values = line.strip().split("|")

                if len(values) == 5:

                    water["id"].append(values[0])
                    water["zone"].append(values[1])
                    water["supplied"].append(float(values[2]))
                    water["date"].append(values[3])
                    water["consumed"].append(float(values[4]))

        messagebox.showinfo(
            "Loaded",
            "Previous records loaded successfully."
        )

        update_dashboard()
        display_records()

    except FileNotFoundError:

        messagebox.showwarning(
            "File Not Found",
            "No saved water records were found."
        )


# =========================================================
# 9. GENERATE ANALYTICAL REPORT
# =========================================================

def generate_report():

    if len(water["id"]) == 0:

        messagebox.showwarning(
            "No Data",
            "Add records before generating a report."
        )

        return

    total_supplied = sum(water["supplied"])
    total_consumed = sum(water["consumed"])
    remaining = total_supplied - total_consumed
    average = total_consumed / len(water["consumed"])

    if total_supplied > 0:
        percentage = (total_consumed / total_supplied) * 100
    else:
        percentage = 0

    try:

        with open("water_analysis_report.txt", "w") as file:

            file.write(
                "SMART WATER DISTRIBUTION ANALYTICAL REPORT\n"
            )

            file.write("=" * 55 + "\n\n")

            file.write(
                f"Total Water Supplied   : {total_supplied:.2f} L\n"
            )

            file.write(
                f"Total Water Consumed   : {total_consumed:.2f} L\n"
            )

            file.write(
                f"Remaining Water        : {remaining:.2f} L\n"
            )

            file.write(
                f"Average Consumption    : {average:.2f} L\n"
            )

            file.write(
                f"Consumption Percentage : {percentage:.2f}%\n\n"
            )

            file.write("ZONE-WISE ANALYSIS\n")
            file.write("-" * 40 + "\n")

            for zone in set(water["zone"]):

                total = 0

                for i in range(len(water["zone"])):

                    if water["zone"][i] == zone:
                        total += water["consumed"][i]

                file.write(
                    f"{zone}: {total:.2f} L\n"
                )

        messagebox.showinfo(
            "Report Created",
            "Analytical report saved as water_analysis_report.txt"
        )

    except Exception as error:

        messagebox.showerror(
            "Error",
            str(error)
        )


# =========================================================
# DASHBOARD UPDATE
# =========================================================

def update_dashboard():

    total_supply = sum(water["supplied"])
    total_use = sum(water["consumed"])
    balance = total_supply - total_use

    if total_supply > 0:
        rate = (total_use / total_supply) * 100
    else:
        rate = 0

    supply_value.config(
        text=f"{total_supply:.0f} L"
    )

    consumed_value.config(
        text=f"{total_use:.0f} L"
    )

    remaining_value.config(
        text=f"{balance:.0f} L"
    )

    rate_value.config(
        text=f"{rate:.1f}%"
    )


